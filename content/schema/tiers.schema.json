{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiers.schema.json",
  "title": "ArduinoPath project tiers",
  "description": "The tiers shown as colour badges and filters on the project picker, in order. Tiers are a guide only: nothing is locked.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tiers"],
  "properties": {
    "$schema": { "type": "string" },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "blurb"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "blurb": { "type": "string", "minLength": 1, "maxLength": 200 },
          "good_first": {
            "description": "Show a \"Good to try first\" tip on this tier's projects until a student finishes their first project.",
            "type": "boolean"
          }
        }
      }
    }
  }
}
